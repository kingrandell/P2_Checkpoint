def average(s1, s2, s3):
    avg = (s1 + s2 + s3) / 3
    return avg

k = int(input("How many students? "))

if k < 3:
    k = 3

for i in range(1,k + 1):
    print("")
    print("Student", i)
    name = input("Enter name: ")
    a1 = int(input("Activity 1: "))
    a2 = int(input("Activity 2: "))
    a3 = int(input("Activity 3: "))

    ave = average(a1, a2, a3)

    if ave >= 90:
        status = "Excellent"
    elif ave >= 80:
        status = "Very Good"
    elif ave >= 75:
        status = "Passed"
    else:
        status = "Failed"

    print("Name:", name)
    print("Average:", ave)
    print("Status:", status)
